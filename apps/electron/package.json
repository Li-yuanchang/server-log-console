{
  "name": "@server-log-console/electron",
  "version": "0.3.273",
  "description": "Server Log Console desktop app",
  "author": "lyc",
  "private": true,
  "main": "main.cjs",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "scripts": {
    "start": "node run-clean-electron-env.cjs electron .",
    "bump-version": "node bump-version.cjs",
    "prepare-gateway": "node prepare-gateway.cjs",
    "prepare-update-config": "node prepare-update-config.cjs",
    "prepare-release-notes": "node prepare-release-notes.cjs",
    "install:mac-app": "node install-mac-app.cjs",
    "predist": "node bump-version.cjs && node prepare-gateway.cjs && node prepare-update-config.cjs && node prepare-release-notes.cjs",
    "predist:mac": "node bump-version.cjs && node prepare-gateway.cjs && node prepare-update-config.cjs && node prepare-release-notes.cjs",
    "predist:win": "node bump-version.cjs && node prepare-gateway.cjs && node prepare-update-config.cjs && node prepare-release-notes.cjs",
    "predist:linux": "node bump-version.cjs && node prepare-gateway.cjs && node prepare-update-config.cjs && node prepare-release-notes.cjs",
    "dist": "node run-clean-electron-env.cjs electron-builder",
    "dist:mac": "node run-clean-electron-env.cjs electron-builder --mac",
    "dist:win": "node run-clean-electron-env.cjs electron-builder --win",
    "dist:linux": "node run-clean-electron-env.cjs electron-builder --linux",
    "release:mac": "npm run dist:mac && npm run install:mac-app"
  },
  "build": {
    "appId": "com.slc.desktop",
    "productName": "SLC",
    "files": [
      "main.cjs",
      "preload.cjs",
      "release-notes.md"
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "extraResources": [
      {
        "from": ".electron-build/gateway",
        "to": "gateway",
        "filter": [
          "**/*",
          "!package-lock.json"
        ]
      },
      {
        "from": ".electron-build/extension/dist",
        "to": "extension/dist"
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*.png",
          "**/*.icns",
          "**/*.ico"
        ]
      },
      {
        "from": ".update-config",
        "to": "update-config",
        "filter": [
          "update-config.json"
        ]
      }
    ],
    "afterPack": "./afterPack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleName": "SLC",
        "CFBundleDisplayName": "日志控制台"
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "generic",
      "url": "http://192.168.2.208/desktop-updates/"
    }
  },
  "devDependencies": {
    "app-builder-bin": "^4.0.0",
    "electron": "32.2.7",
    "electron-builder": "^25.1.8"
  }
}
