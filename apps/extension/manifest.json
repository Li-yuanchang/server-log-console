{
  "manifest_version": 3,
  "name": "日志控制台",
  "version": "0.1.0",
  "description": "通过本地连接服务读取远程服务器日志，支持目录浏览、搜索、实时日志与结果下载。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "日志控制台"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": ["storage", "downloads", "sidePanel"],
  "host_permissions": ["http://localhost:4040/*", "ws://localhost:4040/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
